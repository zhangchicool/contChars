Begin MrBayes;
  execute data.nex;

  lset coding=variable;

  prset nodeagepr=calibrated;
  prset brlenspr=clock:fossilization;
  prset speciationpr=exp(1);
  prset extinctionpr=beta(1,1);
  prset fossilizationpr=beta(1,1);
  prset sampleprob=1.0;
  prset treeagepr=gamma(1,1);
  prset clockratepr=exp(1);
  prset clockvarpr=strict;

  prset topologypr=fixed(myrooted);

  mcmcp nrun=1 nchain=1 ngen=2000000 samplefr=200 printfr=50000;

  propset AddBranch$prob=0;
  propset DelBranch$prob=0;

  mcmc;
  sumt;
  sump;
End;
